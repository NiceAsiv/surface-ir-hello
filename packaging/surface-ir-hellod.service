[Unit]
Description=Surface Go IPU3 Infrared Face Authentication Daemon
After=local-fs.target systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u -m surface_ir_hello.daemon
Restart=on-failure
RestartSec=2
User=root
Group=root
RuntimeDirectory=surface-ir-hello
ProtectHome=true
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
