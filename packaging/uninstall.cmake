if(NOT EXISTS "${MANIFEST}")
    message(FATAL_ERROR "Install manifest not found: ${MANIFEST}")
endif()
file(STRINGS "${MANIFEST}" installed_files)
foreach(path IN LISTS installed_files)
    if(NOT IS_ABSOLUTE "${path}" OR path MATCHES "/[.][.](/|$)")
        message(FATAL_ERROR "Invalid path in install manifest: ${path}")
    endif()
    if(NOT path MATCHES "/surface-ir-hello/config[.]toml$")
        file(REMOVE "${path}")
    endif()
endforeach()
