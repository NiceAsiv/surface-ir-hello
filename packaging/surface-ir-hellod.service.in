[Unit]
Description=Surface Go IPU3 Infrared Face Authentication Daemon
After=local-fs.target systemd-udevd.service

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/surface-ir-hellod
Restart=on-failure
RestartSec=2
User=root
Group=root
RuntimeDirectory=surface-ir-hello
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
