#!/usr/bin/python3 -I
# SPDX-License-Identifier: MIT
import base64
import contextlib
import json
import os
import pwd
import select
import sys

import cv2

from surface_ir_hello.cli import capture_enrollment
from surface_ir_hello.daemon import load_config, verify_samples
from surface_ir_hello.recognizer import IRFaceEngine, normalize_ir10_to_bgr8, update_user_embeddings

SAMPLE_COUNT = 5


def emit(event: str, message: str, **fields):
    print(json.dumps({"event": event, "message": message, **fields}), flush=True)


def preview(frame, detection, captured, status):
    if detection is None:
        image = normalize_ir10_to_bgr8(frame)
    else:
        image = detection["bgr"]
    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    if detection is not None:
        x, y, width, height = detection["bbox"]
        cv2.rectangle(gray, (x, y), (x + width, y + height), 255, 4)
    small = cv2.resize(gray, (160, round(gray.shape[0] * 160 / gray.shape[1])), interpolation=cv2.INTER_AREA)
    ok, png = cv2.imencode(".png", small)
    if ok:
        image_url = "data:image/png;base64," + base64.b64encode(png).decode("ascii")
        emit("preview", status, captured=captured, image=image_url)


def main():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        raise PermissionError("Run the enrollment helper through Polkit without arguments.")
    uid = int(os.environ.get("PKEXEC_UID", "-1"))
    if uid <= 0:
        raise PermissionError("An authenticated desktop user is required.")
    user = pwd.getpwuid(uid).pw_name
    if not user or user in (".", "..") or "/" in user:
        raise ValueError("The desktop account name cannot be used for enrollment.")

    channel = sys.stdin.fileno()
    cfg = load_config()
    with contextlib.redirect_stdout(sys.stderr):
        engine = IRFaceEngine()
    captured = capture_enrollment(
        engine, cfg["ir"], SAMPLE_COUNT, False, on_progress=preview,
        cancelled=lambda: bool(select.select([channel], [], [], 0)[0]),
    )
    if len(captured) != SAMPLE_COUNT:
        emit("result", f"Captured {len(captured)}/{SAMPLE_COUNT} samples before timeout. Existing samples were kept.")
        return 1

    emit("ready", "Return to your normal unlock position, then choose Verify and save.")
    if not select.select([channel], [], [], 45)[0] or os.read(channel, 32) != b"verify\n":
        raise KeyboardInterrupt
    ok, details = verify_samples(engine, captured, cfg)
    if not ok:
        emit("result", f"Live match failed. Existing samples were kept. {details}")
        return 1
    if select.select([channel], [], [], 0)[0]:
        raise KeyboardInterrupt
    total = update_user_embeddings(user, captured, append=True)
    emit("result", f"Saved five new face samples ({total} total). Live verification passed. {details}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (BrokenPipeError, KeyboardInterrupt):
        sys.exit(130)
    except (KeyError, OSError, RuntimeError, ValueError) as error:
        print(f"Surface IR enrollment: {error}", file=sys.stderr)
        emit("result", "Could not finish enrollment. Check that the infrared camera is available.")
        sys.exit(1)
